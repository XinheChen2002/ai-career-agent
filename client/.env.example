# Where the Express server is running. Copy this file to .env.
# Vite only exposes variables that start with VITE_ to the browser.
#
# This value is for LOCAL DEVELOPMENT, where the client and server run at
# different addresses. Vite builds VITE_ variables into the client when you
# run `npm run build`, so before you build for deployment, set this to your
# deployed server's URL. (If the deployed client and server share an
# address, you may not need it -- see the week 9 notes.)
VITE_API_URL=http://localhost:6790
