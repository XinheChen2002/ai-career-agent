{
  "name": "final-project-server",
  "version": "1.0.0",
  "description": "SI 679 final project — the server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9 <23"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run unit.test --passWithNoTests",
    "test:e2e": "vitest run e2e.test"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.7.0",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "mongodb-memory-server": false
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  }
}
