# Copy this file to .env and replace the values with your own.
# .env is in .gitignore: it never goes to GitHub. This file does, which is
# why it holds placeholders rather than real secrets.
#
# These are the variables we think you're likely to want, with values for
# LOCAL DEVELOPMENT. A deployed server doesn't read this file: set the same
# variables, with production values, the way the week 9 notes show.
#
# One way to make a good secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET="replace-me-with-a-long-random-string"

# Where MongoDB is running, and which database the app uses in it.
# These values match a local `mongod` on its default port; the server and
# `npm run seed` fall back to exactly these if the variables are unset.
MONGODB_URI="mongodb://localhost:27017"
DB_NAME="ai_career_agent"

# Where the client runs. The server lets browsers on this origin call it.
CLIENT_ORIGIN="http://localhost:5173"
